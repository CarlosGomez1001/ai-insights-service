# ─── AI Service ────────────────────────────────────────────────────────────
PORT=3005
NODE_ENV=development

# API Key para autenticación backend PHP → microservicio (generar una clave segura)
AI_SERVICE_API_KEY=changeme-generate-a-secure-key

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Si es "true", OpenAIProvider se sustituye por un provider simulado que
# devuelve un insight fijo con la forma correcta, sin llamar a OpenAI.
# Util para probar el flujo PHP -> Node -> PHP sin gastar cuota ni requerir
# una API key real todavia.
MOCK_OPENAI=false
